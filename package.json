{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "kantinku-ubbg-api",
  "description": "Backend API Kantinku UBBG + Postman collection test",
  "private": true,
  "type": "module",
  "scripts": {
    "test:api": "newman run docs/postman/Kantinku-UBBG-API.postman_collection.json -e docs/postman/Kantinku-UBBG-Local.postman_environment.json",
    "test:api:report": "newman run docs/postman/Kantinku-UBBG-API.postman_collection.json -e docs/postman/Kantinku-UBBG-Local.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export docs/screenshots/newman-report.html"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^10.0.3",
    "laravel-vite-plugin": "^3.1",
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  }
}
